{
  "name": "rovefern",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered hiking and backpacking trip planner",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch & node scripts/dev-server.mjs",
    "start": "node scripts/dev-server.mjs",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "leaflet": "1.9.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild": "0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.20.0"
  }
}
